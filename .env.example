# Copy to .env for docker compose (compose reads these names).

# Backend (backend/app/config.py reads these names)
DATABASE_URL=postgres://archive:archive@db:5432/archive
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/app/app_data/storage

# Redis cache key and TTL (seconds)
CACHE_KEY=archive:documents:active
CACHE_TTL=60

# App log level: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# Postgres (docker-compose db service)
POSTGRES_USER=archive
POSTGRES_PASSWORD=archive
POSTGRES_DB=archive

# Upload size limit (bytes) enforced while streaming
MAX_UPLOAD_BYTES=26214400
